{
	// standalone on purpose: content-collections reads the nearest tsconfig
	// through Node, which cannot resolve Kit 3's `$app/tsconfig`
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["content-collections.ts"]
}
